{
  "name": "kiwigardener",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "kiwigardeners.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "KIWI_PRIVATE_CONTACTS",
      "bucket_name": "grideater-public-vertical-feeds-v1"
    }
  ],
  "main": "./src/worker.js",
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "david@americafirst.co.nz"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "2026102801",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFp-C1bXQ7sIIZSa",
    "CONTACT_FORM_ENABLED": "true",
    "BUSINESS_EMAIL_REVEAL_ENABLED": "true",
    "BUSINESS_PHONE_PUBLIC_ENABLED": "true"
  },
  "previews": {
    "vars": {
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFp-C1bXQ7sIIZSa",
      "CONTACT_FORM_ENABLED": "false",
      "BUSINESS_EMAIL_REVEAL_ENABLED": "false"
    },
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "david@americafirst.co.nz"
      }
    ],
    "ratelimits": [
      {
        "name": "CONTACT_LIMIT",
        "namespace_id": "2026102801",
        "simple": {
          "limit": 8,
          "period": 60
        }
      }
    ]
  }
}
