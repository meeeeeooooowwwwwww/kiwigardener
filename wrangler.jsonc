{
  "name": "kiwigardener",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "kiwigardeners.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "main": "./src/worker.js",
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "david@americafirst.co.nz"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "2026102801",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFp-C1bXQ7sIIZSa",
    "CONTACT_FORM_ENABLED": "false"
  }
}
